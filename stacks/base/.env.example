# Copie para stacks/base/.env e preencha.
TZ=America/Sao_Paulo
DATA_DIR=/srv/data

# Tailscale: gere em https://login.tailscale.com/admin/settings/keys (Reusable desligado serve)
TS_AUTHKEY=
TS_HOSTNAME=raspberry-pi
# Ex.: --ssh  (SSH pela tailnet)  ·  --advertise-routes=192.168.0.0/24
TS_EXTRA_ARGS=--ssh

# Postgres compartilhado
PG_ADMIN_USER=admin
PG_ADMIN_PASSWORD=
PG_SHARED_BUFFERS=64MB
PG_MEM_LIMIT=256m

# Watchtower
WATCHTOWER_TOKEN=
WATCHTOWER_POLL_INTERVAL=300
# Só se as imagens no GHCR forem privadas:
GHCR_USER=
GHCR_TOKEN=
# Opcional: telegram://BOT_TOKEN@telegram?chats=CHAT_ID
WATCHTOWER_NOTIFICATION_URL=
