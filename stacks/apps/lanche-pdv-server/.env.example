# Copie para /srv/apps/lanche-pdv-server/.env (chmod 600).
PUBLIC_URL=http://192.168.1.64:3000

# Admin criado só no primeiro start (login + senha de /admin)
ADMIN_EMAIL=admin
ADMIN_PASSWORD=

# E-mail (vazio = códigos aparecem em: docker logs lanche-pdv-server)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
